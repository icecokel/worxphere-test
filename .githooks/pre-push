#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
zero=0000000000000000000000000000000000000000

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  [ "$local_oid" = "$zero" ] && continue
  [ "$remote_oid" = "$zero" ] && continue

  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
    printf '[pre-push] 비 fast-forward push는 허용되지 않습니다: %s\n' "$remote_ref" >&2
    exit 1
  fi
done

cd "$repo_root"
pnpm test:pre-push
